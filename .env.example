APP_NAME=payflow-p2p
APP_ENV=local
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow

DATABASE_URL=postgresql+asyncpg://payflow:payflow@localhost:5432/payflow

JWT_SECRET_KEY=replace-with-a-long-random-secret-for-local-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
