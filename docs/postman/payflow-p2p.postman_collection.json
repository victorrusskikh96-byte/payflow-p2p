		{
			"name": "04 Transfers",
			"item": [
				{
					"name": "Alice Transfer to Bob",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Transfer request handled\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
									"});",
									"",
									"const json = pm.response.json();",
									"",
									"if (pm.response.code === 201) {",
									"    pm.environment.set(\"transfer_id\", json.id);",
									"",
									"    pm.test(\"Transfer id exists\", function () {",
									"        pm.expect(json.id).to.be.a(\"string\").and.not.empty;",
									"    });",
									"",
									"    pm.test(\"Transfer amount is correct\", function () {",
									"        pm.expect(json.amount_minor).to.eql(10000);",
									"    });",
									"",
									"    pm.test(\"Transfer currency is RUB\", function () {",
									"        pm.expect(json.currency).to.eql(\"RUB\");",
									"    });",
									"}",
									"",
									"if (pm.response.code === 400 || pm.response.code === 409) {",
									"    pm.test(\"Transfer rejected with controlled error\", function () {",
									"        pm.expect(json.detail).to.exist;",
									"    });",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
